# ==============================================================================
# Konfigurasi Environment Frontend (Expo) — UrusJakarta
# Salin file ini menjadi `.env` lalu sesuaikan nilainya jika diperlukan.
# ==============================================================================

# URL dasar Backend Express API (tanpa trailing slash).
# Jika dikosongkan, aplikasi otomatis mendeteksi hostname Web atau hostUri Expo pada port 5000.
# Untuk pengujian dari HP fisik (Expo Go) di jaringan lokal, isi dengan IP LAN komputer server:
# Contoh: EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

{
  "expo": {
    "name": "UrusJakarta",
    "slug": "urusjakarta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "urusjakarta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.urusjakarta.app"
    },
    "android": {
      "package": "com.urusjakarta.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UrusJakarta memerlukan akses galeri untuk mengunggah foto kerusakan jalan.",
          "cameraPermission": "UrusJakarta memerlukan akses kamera untuk memotret kerusakan jalan."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UrusJakarta memerlukan akses lokasi GPS untuk menandai titik kerusakan jalan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

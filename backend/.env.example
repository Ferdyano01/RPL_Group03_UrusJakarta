# ==============================================================================
# Konfigurasi Environment Backend — UrusJakarta
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# ==============================================================================

# --- Server Backend Express ---
PORT=5000
NODE_ENV=development
# Digunakan untuk membentuk URL publik gambar saat fallback ke penyimpanan lokal (backend/uploads/)
BACKEND_PUBLIC_URL=http://localhost:5000
# Daftar origin CORS yang diizinkan (pisahkan dengan koma, wajib diisi pada mode production)
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Autentikasi JWT ---
# Ganti dengan string acak yang kuat minimal 16+ karakter (wajib di mode production)
JWT_SECRET=ganti_dengan_rahasia_jwt_yang_kuat

# --- Supabase (Database PostgreSQL & Storage Bucket 'reports') ---
# Opsional pada mode demo: jika kosong/offline, backend otomatis menggunakan
# local fallback (backend/data/local-db.json & backend/uploads/).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Road-AI Microservice (FastAPI + YOLO) ---
ROAD_AI_URL=http://localhost:8000
# Opsional: kunci internal antar-service Backend <-> FastAPI Road-AI
ROAD_AI_API_KEY=

# --- Primary LLM: Qwen (Ollama / OpenAI-compatible, mis. via Tailscale) ---
# Kosongkan QWEN_API_URL jika tidak menggunakan Qwen (akan lanjut ke Gemini / Template Lokal).
# Mendukung juga variabel alias: LLM_API_URL, LLM_API_KEY, LLM_MODEL
QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen2.5:7b
QWEN_CONNECT_TIMEOUT_MS=1500
QWEN_TIMEOUT_MS=5000

# --- Secondary LLM Fallback: Google Gemini API ---
# Kosongkan GEMINI_API_KEY jika tidak menggunakan Gemini (akan lanjut ke Template Lokal).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BACKUP_MODEL=gemini-flash-lite-latest
# Opsional: biarkan kosong untuk memakai endpoint default Google Generative Language API
GEMINI_API_URL=
GEMINI_TIMEOUT_MS=12000
